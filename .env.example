# Copy this file to `.env` inside the run directory
#   - Stage 1: release/entity_extraction/.env
#   - Stage 2: release/tool_calling/agent/.env
# NEVER commit the real .env or the service-account JSON it points to.

# --- Gemini via Vertex AI ---
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1

# --- Azure OpenAI ---
AZURE_API_KEY=your-azure-api-key
AZURE_API_VERSION=2024-08-01-preview
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_DEPLOYMENT=your-deployment-name

# --- Data locations ---
# EHR-ReasonCon bundle from PhysioNet (https://physionet.org/content/ehr-reasoncon/1.0.0/).
# Download it yourself (credentialed access) and place the folder at <release>/EHR_ReasonCon;
# only set this if you keep it elsewhere. Verify with: python check_dataset.py
# EHR_REASONCON_DIR=/path/to/EHR_ReasonCon
# MIMIC-III v1.4 (separate credentialed PhysioNet dataset, https://physionet.org/content/mimiciii/1.4/).
# Download + gunzip the 6 tables listed in the README and place them at <release>/mimiciii/;
# only set this if you keep them elsewhere. Verify with: python check_dataset.py
# MIMIC_DIR=/path/to/mimiciii
# Only for maintainers re-assembling patient_data/ from the raw source dirs (build_patient_data.py):
# EHRCON_DATASET_ROOT=/path/to/raw_annotation_export
# EHRCON_PATIENT_DATA_ROOT=/path/to/raw_patient_tables
